# Deployment
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url
PRIVATE_KEY=your-deployer-private-key

# Off-chain service (use http://127.0.0.1:8545 for Anvil)
RPC_URL=http://127.0.0.1:8545
SENSOR_PRIVATE_KEY=your-sensor-private-key
RELAYER_PRIVATE_KEY=your-relayer-private-key
DATABASE_PATH=./data/sensor-readings.db

# Deployed contract addresses
PARTICIPANT_REGISTRY=0x0000000000000000000000000000000000000000
BATCH_REGISTRY=0x0000000000000000000000000000000000000000
COMPLIANCE=0x0000000000000000000000000000000000000000

# Interaction accounts
ADMIN_PRIVATE_KEY=your-admin-private-key
FARM_PRIVATE_KEY=your-farm-private-key
PROCESSOR_PRIVATE_KEY=your-processor-private-key
LOGISTICS_PRIVATE_KEY=your-logistics-private-key
RETAILER_PRIVATE_KEY=your-retailer-private-key

# Optional contract verification
ETHERSCAN_API_KEY=your-etherscan-api-key
